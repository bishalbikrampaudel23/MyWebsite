# Copy to worker/.env for local Wrangler development. Never commit worker/.env.
# Production secrets belong in Cloudflare Worker secrets, not this file.
ADMIN_PASSWORD=
ADMIN_RECOVERY_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Optional: Wrangler deployment authentication when not using `wrangler login`.
CLOUDFLARE_API_TOKEN=
